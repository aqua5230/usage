# Records docs/statusline.en.gif for the README.
# Run from the repo root: vhs scripts/statusline_demo_en.tape
Output docs/statusline.en.gif

Set Shell bash
Set FontSize 20
Set Width 920
Set Height 200
Set Padding 20
Set TypingSpeed 60ms

Env TT_LANG en

Type "python3 scripts/make_statusline_demo.py"
Sleep 500ms
Enter
Sleep 3s
