# Records docs/statusline.ja.gif for README.ja.md.
# Run from the repo root: vhs scripts/statusline_demo_ja.tape
Output docs/statusline.ja.gif

Set Shell bash
Set FontSize 27
Set Width 2200
Set Height 165
Set Padding 15
Set TypingSpeed 60ms

Env TT_LANG ja

Type "python3 scripts/make_statusline_demo.py"
Sleep 500ms
Enter
Sleep 3s
