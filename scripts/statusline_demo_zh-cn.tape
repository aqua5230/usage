# Records docs/statusline.zh-CN.gif for README.zh-CN.md.
# Run from the repo root: vhs scripts/statusline_demo_zh-cn.tape
Output docs/statusline.zh-CN.gif

Set Shell bash
Set FontSize 27
Set Width 1950
Set Height 165
Set Padding 15
Set TypingSpeed 60ms

Env TT_LANG zh-CN

Type "python3 scripts/make_statusline_demo.py"
Sleep 500ms
Enter
Sleep 3s
