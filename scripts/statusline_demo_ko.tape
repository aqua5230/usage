# Records docs/statusline.ko.gif for README.ko.md.
# Run from the repo root: vhs scripts/statusline_demo_ko.tape
Output docs/statusline.ko.gif

Set Shell bash
Set FontSize 27
Set Width 1950
Set Height 165
Set Padding 15
Set TypingSpeed 60ms

Env TT_LANG ko

Type "python3 scripts/make_statusline_demo.py"
Sleep 500ms
Enter
Sleep 3s
